<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Notas_Csharp.MainWindow"
        Title="Notas_Csharp">

        <StackPanel>

            <UserControl Padding="20" HorizontalAlignment="Center">
                <Button Click="CreateNewNote"> Criar nota </Button>
            </UserControl>


            <StackPanel>
                <Grid x:Name="ContainerNotes" ColumnDefinitions="Auto, Auto, Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Grid.Column="0" Grid.Row="0" x:Name="Notes" Orientation="Vertical" HorizontalAlignment="Center" Margin="0, 0, 15, 15">
                        <TextBox x:Name="Title" Width="300" PlaceholderText="Insira um título para sua nota..." TextChanged="WrittingData"></TextBox>
                        <TextBox x:Name="Content" Width="300" Height="450" PlaceholderText="Insira qualquer informação aqui..." TextChanged="WrittingData"></TextBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        
        </StackPanel>
</Window>
